# Run from the deployment repository root, after sourcing ROS and install/setup.bash.
export SWEEP_WORKSPACE="${SWEEP_WORKSPACE:-$PWD}"
# Replace with the intended robot address. An empty address prevents RTDE startup.
export SWEEP_ROBOT_IP=""
export SWEEP_POLICY_DIR="$SWEEP_WORKSPACE/src/control_package/resource/260311"
export SWEEP_VISION_WEIGHTS="$SWEEP_WORKSPACE/models/vision/best.pt"
export SWEEP_CAMERA_CALIBRATION="$SWEEP_WORKSPACE/config/calibration/orientation.yml"
export SWEEP_TF_CONFIG="$SWEEP_WORKSPACE/config/static_tf.json"
export SWEEP_LOG_DIR="$SWEEP_WORKSPACE/logs"
export SWEEP_RGB_TOPIC="/triton/image_raw"
export SWEEP_POINTCLOUD_TOPIC="/helios/pointcloud_rgb"
# Set these for the optional OptiTrack clients.
export SWEEP_OPTITRACK_CLIENT_IP="127.0.0.1"
export SWEEP_OPTITRACK_SERVER_IP="127.0.0.1"
